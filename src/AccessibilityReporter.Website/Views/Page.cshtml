@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = null;
}

<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>@Model.Value("title")</title>
	<style>
		body {
			margin: 0;
			font-family: Arial, Helvetica, sans-serif;
			color: #222;
			line-height: 1.5;
		}

		header {
			background: #7c0057;
			color: #000;
			padding: 1rem 2rem;
			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		header a {
			color: #000;
		}

		nav ul {
			list-style: none;
			display: flex;
			gap: 1.5rem;
			margin: 0;
			padding: 0;
		}

		.hero {
			background: #f4f6fb;
			padding: 3rem 2rem;
			text-align: center;
		}

		.hero h1 {
			margin-bottom: 0.5rem;
		}

		main {
			max-width: 960px;
			margin: 0 auto;
			padding: 2rem;
		}

		.card-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
			gap: 1.5rem;
			margin: 2rem 0;
		}

		.card {
			border: 1px solid #ddd;
			border-radius: 6px;
			padding: 1.25rem;
		}

		form {
			margin: 2rem 0;
			padding: 1.5rem;
			background: #f9f9f9;
			border-radius: 6px;
		}

		label {
			display: block;
			margin-bottom: 0.25rem;
			font-weight: bold;
		}

		input,
		textarea {
			width: 100%;
			padding: 0.5rem;
			margin-bottom: 1rem;
			border: 1px solid #ccc;
			border-radius: 4px;
			box-sizing: border-box;
		}

		button {
			background: #1b2a4a;
			color: #fff;
			border: none;
			padding: 0.6rem 1.2rem;
			border-radius: 4px;
			cursor: pointer;
		}

		footer {
			background: #7c0057;
			color: #000;
			text-align: center;
			padding: 1.5rem;
			margin-top: 2rem;
		}
	</style>
</head>
<body>
	<header>
		<a href="#"><strong>Site Name</strong></a>
		<nav aria-label="Primary">
			<ul>
				<li><a href="#">Home</a></li>
				<li><a href="#">About</a></li>
				<li><a href="#">Services</a></li>
				<li><a href="#">Contact</a></li>
			</ul>
		</nav>
	</header>

	<section class="hero">
		<h1>@Model.Value("title")</h1>
		<p>@Model.Value("body")</p>
	</section>

	<main>
		<article>
			<h2>About this page</h2>
			<p>
				This page is used for testing the Accessibility Reporter tool against
				realistic page content, including headings, links, images, and forms.
			</p>
			<img src="https://picsum.photos/800/300" />
		</article>

		<div class="card-grid">
			<div class="card">
				<h3>Feature One</h3>
				<p>A short description of a feature or service offered on this site.</p>
				<a href="#">Learn more</a>
			</div>
			<div class="card">
				<h3>Feature Two</h3>
				<p>Another short description used to pad out the page content.</p>
				<a href="#">Learn more</a>
			</div>
			<div class="card">
				<h3>Feature Three</h3>
				<p>A final example card so the layout has more than one column.</p>
				<a href="#">Learn more</a>
			</div>
		</div>

		<form>
			<h2>Get in touch</h2>
			<label for="name">Name</label>
			<input type="text" id="name" name="name" />

			<label>Email</label>
			<input type="email" name="email" />

			<label for="message">Message</label>
			<textarea id="message" name="message" rows="4"></textarea>

			<button type="submit">Send message</button>
		</form>
	</main>

	<footer>
		<p>&copy; @DateTime.Now.Year Site Name. All rights reserved.</p>
	</footer>

	<script>
		// Deliberately blocks the main thread for ~1.5s to simulate a slow, janky page.
		(function () {
			var end = Date.now() + 1500;
			while (Date.now() < end) { /* busy-wait */ }
		})();
	</script>

	@Html.AccessibilityReporterScript()
</body>
</html>
