<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- Nuget Properties -->
    <PropertyGroup>
        <PackageId>Umbraco.Community.AccessibilityReporter.AI</PackageId>
        <Title>Accessibility Reporter AI</Title>
        <Description>Optional add-on for Accessibility Reporter that generates AI-powered summaries of accessibility reports using Umbraco.AI.</Description>
        <PackageTags>Accessibility; WCAG; Umbraco; AI; umbraco-marketplace;</PackageTags>
        <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/mattbegent/umbraco-accessibility-reporter</RepositoryUrl>
        <PackageProjectUrl>https://github.com/mattbegent/umbraco-accessibility-reporter</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Copyright>Matt Begent</Copyright>
        <PackageIcon>logo.png</PackageIcon>
        <PackageReleaseNotes>Initial release of the Accessibility Reporter AI add-on.</PackageReleaseNotes>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <!-- Create Nuget on Build with snupkg (symbols/debug/pdbs) -->
    <PropertyGroup>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <IncludeSymbols>True</IncludeSymbols>
    </PropertyGroup>

    <!-- Readme, Logo etc needed for Nuget Package -->
    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\logos\logo.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- Project References -->
    <ItemGroup>
        <ProjectReference Include="..\AccessibilityReporter.Core\AccessibilityReporter.Core.csproj" />
    </ItemGroup>

    <!-- Nuget References -->
    <ItemGroup>
        <PackageReference Include="Umbraco.AI" Version="1.4.1" />
    </ItemGroup>

</Project>
